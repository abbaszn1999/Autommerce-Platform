# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# The platform to record (default https://platform.autommerce.com)
BASE_URL=https://platform.autommerce.com

# Autommerce login used in the video (the reviewer test account is best).
# Leave empty to type them yourself while recording.
REVIEW_EMAIL=
REVIEW_PASSWORD=

# The workspace slug in the address: https://platform.autommerce.com/w/<slug>/...
WORKSPACE_SLUG=

# The preview password of the Google/Meta Ads pages (leave empty to type it yourself).
PREVIEW_PASSWORD=

# A campaign name (or part of it) that is safe to pause in the video, e.g. an old finished one.
CAMPAIGN_TO_PAUSE=

# No active campaign? A paused/old campaign ID (digits, safest) or exact name: renamed with " (reviewed)", then renamed back.
# Used only when CAMPAIGN_TO_PAUSE is empty.
CAMPAIGN_TO_RENAME=

# Optional: pick these in the asset picker (digits only). Empty = keep what is pre-selected.
AD_ACCOUNT_ID=
BUSINESS_ID=
PAGE_ID=
CATALOG_ID=

# 1 = skip Vera's steps (a test run while the agent is down). Leave empty for the real video.
SKIP_AGENT=
